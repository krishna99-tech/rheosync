# ==============================================================================
# WALVOIL — IoT VISCOSITY SYSTEM ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=5001
FLASK_DEBUG=0

# IoT Telemetry Receiver (UDP)
UDP_IP=0.0.0.0
UDP_PORT=63363
OFFLINE_TIMEOUT=30
STATION_NAME="Walvoil Viscosity Testing Station"

# Database Path
DB_PATH=device_data.db

# Storage Directory for Generated Reports (Leave commented for default ./Reports, or set custom path e.g. C:\Walvoil_Reports)
# REPORTS_DIR=C:\Walvoil_Reports

# Timezone (Used on Linux & Docker containers - leave commented on Windows to use host clock)
# TZ=Asia/Kolkata

